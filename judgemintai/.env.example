# Copy this file to ".env" and fill in your values. NEVER commit ".env".

PORT=3000

# ---------- AI (any OpenAI-compatible API) ----------
# Leave LLM_API_KEY empty to run in "heuristic mode" (no AI calls, still fully working).
# Free option: create a key at https://aistudio.google.com/apikey and keep the defaults below.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Model calls per minute. Gemini's free tier allows about 10, which is the default for the Gemini address above.
# Set 0 for no limit when your plan allows more. LLM_RETRY_MS is the wait before retrying a "too many requests" answer.
LLM_RPM=
LLM_RETRY_MS=6000

# ---------- Judge mode: run a whole competition ----------
# The key organisers and judges type to open Judge mode (it shows entry emails and can pay prizes).
# Leave empty and the server makes one on first start, prints it, and keeps it in data/.organizer_key.
ORGANIZER_KEY=
# How many entries a competition evaluates by default, and the most this server will ever allow.
# Keep MAX_PROJECTS_HARD small on a small server; raise it on a bigger one.
MAX_PROJECTS_DEFAULT=10
MAX_PROJECTS_HARD=50
# Entries evaluated at the same time (1 to 4).
EVAL_CONCURRENCY=2
# The largest single prize this server will send.
MAX_PAYOUT_PER_PRIZE=5000
# Prize payments use PayPal's SANDBOX (test money). Leave this unset. Only set it to "true" if you also use LIVE PayPal keys
# and really mean to pay real money.
ALLOW_LIVE_PAYOUTS=

# ---------- GitHub (recommended for Judge mode) ----------
# A free personal access token (no scopes needed) raises the API limit from 60 to 5000 requests/hour.
# Without it GitHub allows about 10 entries per hour.
GITHUB_TOKEN=

# ---------- YouTube (optional) ----------
# With a free YouTube Data API key the Legal agent can verify "public" and "under 3 minutes" automatically.
# Without it those two checks are marked "verify manually".
YOUTUBE_API_KEY=

# ---------- PayPal SANDBOX ----------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CERT_PRICE_USD=2.00
# How orders reach PayPal:
#   auto    = PayPal AI Toolkit (PayPal's MCP server) first, PayPal's REST API as the safety net (default)
#   toolkit = the toolkit only (good for a demo video, no safety net)
#   rest    = PayPal's REST API only (needs no npm download)
PAYPAL_VIA=auto
# Where buyers return to after PayPal. Leave empty on your own computer. Render fills it in by itself.
PUBLIC_URL=
# Secret used to sign audit certificates. If empty, one is generated into ./data/.cert_secret
CERT_SECRET=

# ---------- Sponsor integrations (all optional) ----------
# Zapier: create a Zap with the "Catch Hook" trigger and paste its webhook URL here.
ZAPIER_WEBHOOK_URL=
# Elastic: Elasticsearch endpoint + API key. Single audits are indexed when they finish, and every entry of a competition
# is indexed when the judges finalise it (rank, scores, flags and the reason; never an email address).
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=judgemint-audits
ELASTIC_ENTRIES_INDEX=judgemint-entries

# ---------- Safety ----------
AUDIT_RATE_LIMIT_PER_HOUR=20
